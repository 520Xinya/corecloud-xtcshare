<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CenteredVerticalLayout">
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="CenteredTextViewStyle">
        <item name="android:textSize">13.0sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4.0dp</item>
        <item name="android:textCursorDrawable">@android:color/white</item>
    </style>

    <style name="CustomShareImageViewStyle">
        <item name="android:layout_width">60.0dp</item>
        <item name="android:layout_height">60.0dp</item>
    </style>

    <style name="CustomEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textCursorDrawable">@android:color/white</item>
    </style>
</resources>