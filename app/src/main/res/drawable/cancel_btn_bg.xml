<?xml version="1.0" encoding="utf-8"?><selector xmlns:android="http://schemas.android.com/apk/res/android">    <item android:state_pressed="false">        <shape android:shape="rectangle">            <corners android:radius="16dp" />            <solid android:color="#FF2F2F2F" />        </shape>    </item>    <item android:state_pressed="true">        <shape android:shape="rectangle">            <corners android:radius="16dp" />            <solid android:color="#4D2F2F2F" />        </shape>    </item></selector>